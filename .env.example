# single local env file — every key is validated at boot by src/lib/env.ts
# (t3-env, crash-early on anything missing)

# backblaze (photo/object storage)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=us-east-005

# authz — authentik oidc + session signing (sealed into personal-site-runtime)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
AUTHENTIK_ISSUER=

# postgres (app schema for better-auth tables + pgh dashboard snapshots)
PGH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pgh_tickets

LOG_LEVEL=info
